digraph G { rankdir=TB; nodesep=0.6; bgcolor="transparent"; node [shape=box, style="rounded,filled", fontname="Inter", fontsize=12, color="#93c5fd", fillcolor="#eff6ff", margin="0.2,0.1"]; edge [fontname="Inter", fontsize=10, color="#64748b"];
  first [label="First visit"]; pick [label="Programme picker\ndegree · branch · semester"]; mine [label="My programme\nonly this semester's subjects", fillcolor="#f0fdf4", color="#86efac"]; browse [label="Browsing mode\nbanner + Back button", fillcolor="#fef3c7", color="#fcd34d"];
  first -> pick; pick -> mine [label=" Set as my programme"]; pick -> browse [label=" Just browse"]; {rank=same; mine; browse}
  mine -> browse [label=" another semester\n or a search result"]; browse -> mine [label=" Back to my semester"]; }
