# Database connection (Neon Postgres / Cloud SQL / PostgreSQL)
DATABASE_URL=

# Optional Google Authentication
GOOGLE_CLIENT_ID=

# Optional admin dashboard access.
# ADMIN_SECRET: a long random secret (12+ characters) sent as the x-admin-secret header.
# Leave it empty to allow only Google sign-in with an ADMIN_EMAILS account.
# Without DATABASE_URL (local mock store) the development secret admin123 also works.
ADMIN_SECRET=
ADMIN_EMAILS=

# Optional: Vercel Blob token for avatars and student uploads
BLOB_READ_WRITE_TOKEN=
